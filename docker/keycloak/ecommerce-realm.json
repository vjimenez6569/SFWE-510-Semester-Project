        "composite": true,
        "composites": {
          "client": {
            "ecommerce-project": [
              "VIEW_PRODUCTS",
              "PLACE_ORDERS",
              "VIEW_OWN_ORDERS",
              "MANAGE_OWN_PROFILE"
            ]
          }
        }
      },
      {
        "name": "ADMIN",
        "description": "Ecommerce administrator",
        "composite": true,
        "composites": {
          "client": {
            "ecommerce-project": [
              "MANAGE_PRODUCTS",
              "MANAGE_ORDERS",
              "MANAGE_CUSTOMERS"
            ]
          }
        }
      }
    ],
    "client": {
      "ecommerce-project": [
        {
          "name": "VIEW_PRODUCTS"
        },
        {
          "name": "PLACE_ORDERS"
        },
        {
          "name": "VIEW_OWN_ORDERS"
        },
        {
          "name": "MANAGE_OWN_PROFILE"
        },
        {
          "name": "MANAGE_PRODUCTS"
        },
        {
          "name": "MANAGE_ORDERS"
        },
        {
          "name": "MANAGE_CUSTOMERS"
        }
      ]
    }
  },
  "defaultRoles": [
    "CUSTOMER"
  ],
  "clients": [
    {
      "clientId": "ecommerce-project",
